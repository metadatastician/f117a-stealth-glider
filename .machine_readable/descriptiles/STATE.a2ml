# SPDX-License-Identifier: MPL-2.0
# STATE.a2ml — F117A Stealth Glider
#
# Current project state, phase, and route to the next milestone.
# Machine-readable snapshot; keep in sync with README.md and VERIFICATION.md.
#
# This file described the WRONG GAME until 2026-07-28. The repository was
# scaffolded by copying f19-stealth-glider, and this snapshot arrived carrying
# that repository's level, threats, scripts and settled questions. Nothing
# could catch it: the probe that claimed to guard it had only a prose
# `tolerance:` field, which the contractile runner does not execute.
# scripts/metadata-citations.mjs now checks this file mechanically — every
# source path it cites must exist, and another level's vocabulary fails.

[metadata]
project = "F117A Stealth Glider"
version = "0.1.0"
type = "game"
last-updated = "2026-07-28"
branch = "main"
build-status = "green"
test-status = "12-claim ledger (C1-C12), all green and all GATING in CI on every push; plus bundle byte-reproducibility and 63 contractile probes. `just ci` runs the lot."

[project-context]
description = "A stealth puzzle played on a live Conway's Game of Life field (B3/S23). The player flies a single glider across a hostile cellular-automaton airspace to a hangar without ever contacting the substrate's live cells — and without being SEEN. Threat is radar: sensors cast supercover line-of-sight across the corridor, and the only cover that moves is the automaton itself, so staying hidden means reading the substrate's phase. Every threat is a real Life pattern evolving deterministically, not a scripted sprite."
subtitle = "Operation Nightglass"
tagline = "The substrate is the enemy — and the only cover."
substrate = "B3/S23"
language = "javascript"
module-system = "esm"
runtime = "node >= 18 (verification) / any modern browser (play)"
dependencies = "none"
depends-on = []
distribution = "single self-contained f117a-stealth-glider.html at the repo root; published to GitHub Pages from the committed, verified artefact"

[level]
# src/level.mjs is the single source of truth — this mirrors it, it does not
# override it. Every value below is asserted by a contractile `- run:` grep or
# by claim C12, so a drift here fails rather than misleads.
name = "Operation Nightglass"
width = 172
height = 108
spawn = "[12, 16] heading [1, 1] (SE)"
hangar = "[92, 96] (sym-4 eater1)"
corridor = "y = x + 4, from [12,16] to [92,96]"
chokepoint = "wall() across the corridor at chokeX = 56, 2x2 blocks stepped 5 along (1,-1), spanning the full in-bounds line, with a single 1-wide gap"
shutters = "two pentadecathlons at [68,68] and [66,79] — the second seals the sub-LOCK escape route"
sensors = "RDR-1 [88,8], RDR-2 [14,74], RDR-3 [140,66] at radarRange 40; RDR-GATE [79,73] at its own range 23"
clean-glidepaths = "[-10, -4, 3] — measured, 3 of 21 lanes land cleanly; spawn sits on lane -4"
period = "15 (lcm of p15 pentadecathlon and p3 pulsar), transient 0 — C11"
lock = "8 (exposure dwell; +1 painted, -1 clean)"
# f19-contrast: there is deliberately no Gosper gun in this level.
# A gun's 347-generation transient would destroy C11's transient-0 property,
# on which the solver's `phase = t mod P` indexing and therefore C6 both rest.
# f19-contrast: see the block titled WHY NO GOSPER GUN in src/level.mjs.

[roadmap]
phases = "v0 Nightglass (level + ledger) > v1 playable (renderer, camera, bundle) > v2 second level > multi-level campaign"
current-phase = "v1 playable"
phase-goal = "One complete, fully verified level whose substrate is provably load-bearing — unsolvable by feel, solvable by reading the automaton — and a playable artefact whose presentation layer provably cannot touch the mission."
phase-status = "complete and verified. C6 (the falsifier) is green at 14/14 off-phase PAINTED with no sub-LOCK route anywhere in the state space; the game ships as one reproducible bundle; all twelve claims gate CI."

[component-status]
engine = { percent = 100, notes = "src/kernel/engine.mjs — VENDORED VERBATIM from f19@9effa596, blob c7a016ec. No local changes are permitted; fix upstream and re-vendor. C1 asserts it as a git blob id, offline." }
mission = { percent = 100, notes = "src/mission.mjs — DECLARED FORK of f19's mission core plus five fenced blocks carrying the radar channel. C1 strips the fences and requires the remainder to hash to blob 30f93a70." }
radar = { percent = 100, notes = "src/radar.mjs — supercover LOS, sensor self-occlusion exemption, exposure dwell, shadowMap. C2 and C3, both canary-tested." }
level = { percent = 100, notes = "src/level.mjs — Operation Nightglass geometry. Knife-edged: the gate sensor and shutter positions are one-cell optima found by sweep, not chosen." }
render3d = { percent = 100, notes = "src/render3d.mjs — pure chase camera + draw list. No DOM, no clock, no randomness, no imports. C7 proves it cannot influence the mission." }
ui = { percent = 90, notes = "src/ui.js — browser render, input and HUD only; carries no gameplay truth. Owns the repository's only frame clock, legitimate because C7 fences the layer below it." }
verification = { percent = 100, notes = "12-claim ledger C1-C12 in VERIFICATION.md, every claim a named script under src/, all gating." }
bundle = { percent = 100, notes = "src/build.mjs emits the self-contained HTML, syntax-checks the shipped script and replays the witness on the TRANSFORMED core; CI asserts byte-identity with the committed file (C10)." }

[settled-questions]
# Recorded here because they are CLOSED, with the evidence that closed them.
# Every citation below is to a script in THIS repository that you can run.
resolved = [
  { question = "Is the level phase-critical, or is the radar scenery?", answer = "Phase-critical, measured.", evidence = "src/verify-falsifier.mjs (C6)", cause = "The witness flown at all 14 off-phase launches dies PAINTED 14 times while the on-phase flight lands with trace 0; and an exhaustive search over (anchor, heading, phase, exposure) finds NO route that stays below exposure LOCK-1. Every flyable line grazes one generation from death, so the only freedom is WHEN." },
  { question = "Was it enough to prove the SHIPPED ROUTE dies off-phase?", answer = "No — and that gap was real.", evidence = "src/verify-falsifier.mjs fourth assertion", cause = "Witness-scoped assertions cannot see a DIFFERENT route that lands at every phase. One existed: a zigzag hugging the gate sensor's range circle, dipping in for 3-4 generations and draining the dwell counter between dips, peak exposure 4, landing at all 15 phases. Sealing it took gate range 23 plus a second shutter at [66,79]." },
  { question = "Should the world be a 3D automaton so the player is a genuine 3D spaceship?", answer = "No. The third dimension moves to the camera.", evidence = "src/verify-3d-rule-search.mjs (C9)", cause = "3D Life has no glider ECOLOGY: 180 seeded soups per rule on a 24^3 torus produce 0 translating patterns in Bays 5766 and in 4555. Bays's gliders exist only from directed search, and an ecology you must construct by hand is not an ecology." },
  { question = "Would a SECOND gate sensor onto the gap make the level phase-critical?", answer = "No — measured dead.", evidence = "design/place.mjs pipeline, 2,016 configurations", cause = "Every candidate collided, broke periodicity, or sealed the map at all phases. A second SHUTTER on the existing sensor is what worked instead." },
  { question = "May the renderer use a frame clock, when C8 bans clocks from the simulation?", answer = "Yes, above the C7 line.", evidence = "src/verify-renderer.mjs (C7)", cause = "The witness flown with and without the entire presentation path hashes identically at all 469 generations, with a canary proving a mutating renderer is caught. The exclusion is earned by proof, not granted by convenience." },
  { question = "Should the contact rule be relaxed from Chebyshev 2 to cell-overlap?", answer = "No — that trips the standing falsifier inherited from f19.", evidence = "Design invariant; src/mission.mjs nearWorld(M, cells, 2)", cause = "Chebyshev 3 is the exact independence criterion: while the aircraft keeps it, 'not being in the world' and 'being in it' are provably indistinguishable. Relaxing it makes the route learnable by feel, which turns the substrate back into scenery." },
]

[open-decisions]
remaining = [
  { item = "Whether the second level reuses the chokepoint-and-shutter grammar or looks for a different phase mechanism", resolve-by = "start of v2", notes = "The current level's parameters are one-cell optima; whether that fragility is inherent to the grammar or an artefact of this geometry is unknown." },
  { item = "Whether level content should be split out of src/level.mjs into a data file under a content licence (CC-BY-SA-4.0)", resolve-by = "when a second level exists", notes = "Today the level is code and is AGPL like everything else, so no content licence is vendored." },
  { item = "Whether LOCK = 8 is justified specifically, rather than merely bounded", resolve-by = "when a second level exists", notes = "design/sweep.mjs shows LOCK 5 and 6 make this level unsolvable, which bounds it from below. AUDIT.adoc carries this as argued, not verified." },
]

[route-to-next]
remaining = [
  { item = "A second level, to prove the engine and the grammar generalise beyond one frozen geometry", priority = "high" },
  { item = "Playtest the camera and HUD for readability — nothing measures whether the game is any good, only that it is honest", priority = "high" },
  { item = "Promote design/place.mjs's sweep pipeline into a reusable level-search harness", priority = "medium" },
  { item = "Measure shadowMap's per-tick cost against a frame budget; AUDIT records that nothing does yet", priority = "low" },
]
